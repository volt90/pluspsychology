{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/gallery",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noimageindex"}]
    },
    {
      "source": "/gallery/:path*",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noimageindex"}]
    }
  ],
  "crons": [{"path": "/api/mind-forest-photo", "schedule": "0 18 * * *"}]
}
